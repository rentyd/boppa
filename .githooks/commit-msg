#!/bin/sh

set -eu

expected_identity='rentyd <350862613+rentyd@users.noreply.github.com>'

author_identity=$(git var GIT_AUTHOR_IDENT)
committer_identity=$(git var GIT_COMMITTER_IDENT)

case "$author_identity" in
  "$expected_identity "*) ;;
  *)
    printf '%s\n' \
      "Commit rejected: author must be $expected_identity" \
      "Actual author: ${author_identity% * *}" >&2
    exit 1
    ;;
esac

case "$committer_identity" in
  "$expected_identity "*) ;;
  *)
    printf '%s\n' \
      "Commit rejected: committer must be $expected_identity" \
      "Actual committer: ${committer_identity% * *}" >&2
    exit 1
    ;;
esac

if grep -Eiq '^[[:space:]]*co-authored-by[[:space:]]*:' "$1"; then
  printf '%s\n' 'Commit rejected: Co-authored-by trailers are not allowed.' >&2
  exit 1
fi
